# WEALTHFORGE OS — environment configuration
# Copy to .env and fill in as needed. Nothing here is required for core
# local-first operation (budget, portfolio, goals, liabilities, dashboard).
# Only market data refresh and non-default AI providers require network access.

# --- Database (local-first; SQLite file on disk) ---
# NOTE: Prisma resolves a relative SQLite path relative to prisma/schema.prisma's
# directory, not the process working directory — so this must be "../data/..."
# (one level up from prisma/) to land at the repo-root data/ directory that
# README.md, CLAUDE.md, and .gitignore all assume. Do not "simplify" this to
# "file:./data/wealthforge.db" — that silently creates prisma/data/wealthforge.db
# instead, which is NOT covered by .gitignore's data/*.db pattern.
DATABASE_URL="file:../data/wealthforge.db"

# --- AI provider (default: local via Ollama; no key required) ---
# See docs/features/ai-analyst.md. One of: ollama | openai | anthropic
AI_PROVIDER="ollama"
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="llama3.1"

# Optional cloud AI providers (never required; behind the provider abstraction).
# Selecting one of these as AI_PROVIDER without its key set falls back to
# "AI unavailable" rather than a failed request.
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-3-5-haiku-latest"

# --- Market data (M10) ---
# No configuration needed: mutual fund NAVs come from AMFI's official free
# file and index/equity prices from Yahoo Finance's free (unofficial)
# endpoint, both unauthenticated. Neither is required — the app shows
# "no data"/the last known price if unreachable. See
# docs/MARKET_DATA_PROVIDER_EVALUATION.md (D-007).

# --- Optional report delivery via SMTP/Gmail (not yet implemented; reserved) ---
# The M10 report (docs/features/market-data.md) is a local, printable HTML
# page — no email server is required to use it. These are reserved for a
# possible future optional "email me the report" feature, never required.
SMTP_HOST=""
SMTP_PORT=""
SMTP_USER=""
SMTP_PASSWORD=""
REPORT_RECIPIENT_EMAIL=""

# --- App ---
NODE_ENV="development"
PORT="3000"
