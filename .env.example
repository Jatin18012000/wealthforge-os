# WEALTHFORGE OS — environment configuration
# Copy to .env and fill in as needed. Nothing here is required for core
# local-first operation (budget, portfolio, goals, liabilities, dashboard).
# Only market data refresh and non-default AI providers require network access.

# --- Database (local-first; SQLite file on disk) ---
# NOTE: Prisma resolves a relative SQLite path relative to prisma/schema.prisma's
# directory, not the process working directory — so this must be "../data/..."
# (one level up from prisma/) to land at the repo-root data/ directory that
# README.md, CLAUDE.md, and .gitignore all assume. Do not "simplify" this to
# "file:./data/wealthforge.db" — that silently creates prisma/data/wealthforge.db
# instead, which is NOT covered by .gitignore's data/*.db pattern.
DATABASE_URL="file:../data/wealthforge.db"

# --- AI provider (default: local via Ollama; no key required) ---
# One of: ollama | openai | anthropic
AI_PROVIDER="ollama"
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="llama3.1"

# Optional cloud AI providers (never required; behind the provider abstraction)
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""

# --- Market data provider (optional; core app works without it) ---
# Leave unset to run with no live market data — the dashboard will show
# "no live data configured" rather than fabricating prices.
MARKET_DATA_PROVIDER=""
MARKET_DATA_API_KEY=""

# --- Optional report delivery via SMTP/Gmail (never required) ---
SMTP_HOST=""
SMTP_PORT=""
SMTP_USER=""
SMTP_PASSWORD=""
REPORT_RECIPIENT_EMAIL=""

# --- App ---
NODE_ENV="development"
PORT="3000"
