# Database for `pnpm e2e` (Playwright) — completely separate from
# data/wealthforge.db, the account owner's real local database.
#
# playwright.config.ts loads this file explicitly (never the app's own
# .env), refuses to start if this value points at wealthforge.db, and
# pushes it onto the spawned app server's environment so Next.js's own
# .env loading cannot override it. webServer.command applies migrations
# and demo fixtures to this file before starting the app, on every run.
#
# Safe to commit — it names a path, not a secret.
DATABASE_URL="file:../data/e2e-test.db"
